<Project>
	<Import Project="..\..\repo.props"/>
	<PropertyGroup>
		<PackagePublisher Condition="'$(PackagePublisher)' == ''">$(Publisher)</PackagePublisher>
		<PackagePublisherDisplayName Condition="'$(PackagePublisherDisplayName)' == ''">$(PublisherDisplayName)</PackagePublisherDisplayName>
		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<PackageName Condition="'$(PackageName)' == ''">DevAxxAddCartLinesToCart</PackageName>
		<PackageDisplayName Condition="'$(PackageDisplayName)' == ''">Extension para generar Reportes cuando se agrega un producto al carrito</PackageDisplayName>
		<PackageDescription Condition="'$(PackageDescription)' == ''">Extension para generar Reportes cuando se agrega un producto al carrito</PackageDescription>
	</PropertyGroup>
	<Import Project="..\CustomizationPackageReferences.props "/>
</Project>